# ==============================================================================
# Smart Event Manager — Environment Configuration Template (.env.example)
#
# COPY this file to '.env' and populate with your production values.
# NEVER commit the active '.env' file containing real credentials to source control.
# ==============================================================================

# ── Database Configuration ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=event_management

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a cryptographically strong random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── CORS Configuration ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# ── Gmail API (HTTPS OAuth2 — Render Free Compatible) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smart-event-manager-o8m9.onrender.com/gmail/callback
GMAIL_SENDER_EMAIL=
GMAIL_REFRESH_TOKEN=

# ── Server Settings ──────────────────────────────────────────────────────────
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
