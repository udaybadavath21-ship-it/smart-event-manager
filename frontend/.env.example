# ==============================================================================
# Smart Event Manager — Frontend Environment Configuration (.env.example)
#
# COPY this file to '.env' or '.env.production' in the frontend directory.
# During build time (npm run build), Vite embeds VITE_* variables into assets.
# ==============================================================================

# Backend API Base URL (leave empty or set to http://localhost:8000 for local development)
VITE_API_URL=http://localhost:8000
